# Copia este fichero a .env y cambia los valores
POSTGRES_USER=n8n
POSTGRES_PASSWORD=cambia-esta-contraseña
POSTGRES_DB=n8n

# Clave para cifrar las credenciales guardadas en n8n.
# Genera una con:  openssl rand -hex 32
N8N_ENCRYPTION_KEY=

TZ=Europe/Madrid
# Fija una versión concreta si quieres builds reproducibles (p. ej. 2.49.8)
N8N_VERSION=stable
